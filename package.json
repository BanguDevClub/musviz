{
  "name": "musviz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn any track into a studio-grade music visual. Runs entirely in your browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BanguDevClub/musviz.git"
  },
  "homepage": "https://bangudevclub.github.io/musviz/",
  "bugs": {
    "url": "https://github.com/BanguDevClub/musviz/issues"
  },
  "license": "MIT",
  "author": "BanguDevClub",
  "keywords": [
    "music",
    "visualizer",
    "audio",
    "canvas",
    "mediabunny",
    "react",
    "video-export"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview",
    "assets": "node scripts/generate-assets.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "validate": "npm run check && npm run build",
    "clean": "rm -rf dist node_modules/.vite node_modules/.tmp",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "ci": "npm ci && npm run validate"
  },
  "dependencies": {
    "mediabunny": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
